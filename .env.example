# Copy this file to ".env" and fill in your own values. ".env" is git-ignored.
# The backend reads these as environment variables. scripts/start-backend.ps1 loads them for you on Windows.

# --- PostgreSQL container (used only by docker-compose.yml) ---
POSTGRES_DB=cinefy
POSTGRES_USER=cinefy
POSTGRES_PASSWORD=change_me

# --- Backend (Spring Boot) ---
# JDBC URL, NOT the postgresql:// URL that hosting dashboards show you. See README > Deployment.
DB_URL=jdbc:postgresql://localhost:5432/cinefy
DB_USERNAME=cinefy
DB_PASSWORD=change_me
# Comma-separated browser origins allowed to call the API (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Insert sample data when the database is empty (true/false).
SEED_ENABLED=true
# update = create tables automatically (demo). Use "validate" once you adopt Flyway.
DDL_AUTO=update

# --- Frontend (Vite). Put this one in cinefy-frontend/.env.local ---
VITE_API_BASE_URL=http://localhost:8080
