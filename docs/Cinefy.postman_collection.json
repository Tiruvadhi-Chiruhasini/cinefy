{
  "info": {
    "name": "Cinefy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set the collection variable baseUrl (default http://localhost:8080). Sample data must be loaded."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "List movies (filter + sort)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies?q=&genre=Drama&sort=rating&dir=desc&page=0&size=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies"
              ],
              "query": [
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "genre",
                  "value": "Drama"
                },
                {
                  "key": "sort",
                  "value": "rating"
                },
                {
                  "key": "dir",
                  "value": "desc"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "12"
                }
              ]
            }
          }
        },
        {
          "name": "List genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/genres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies",
                "genres"
              ]
            }
          }
        },
        {
          "name": "Get movie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies",
                "1"
              ]
            }
          }
        },
        {
          "name": "Related movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/1/related?limit=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies",
                "1",
                "related"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "4"
                }
              ]
            }
          }
        },
        {
          "name": "Create movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Film\",\n  \"genre\": \"Drama\",\n  \"releaseYear\": 2025,\n  \"description\": \"Created from Postman.\"\n}"
            }
          }
        },
        {
          "name": "Update movie",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/movies/41",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies",
                "41"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Film (edited)\",\n  \"genre\": \"Drama\",\n  \"releaseYear\": 2025,\n  \"description\": \"Edited.\"\n}"
            }
          }
        },
        {
          "name": "Delete movie",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/movies/41",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "movies",
                "41"
              ]
            }
          }
        }
      ]
    },
